{
  "name": "agentflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:workflow": "tsc -p tests/kimi-engine/tsconfig.json && node tests/kimi-engine/test.js",
    "test:phase1": "tsc -p tests/phase1/tsconfig.json && node tests/phase1/test.js && node tests/phase1/builder-e2e.js",
    "test:hardening": "tsc -p tests/production-hardening/tsconfig.json && node tests/production-hardening/out/tests/production-hardening/test.js",
    "test:e2e": "node tests/e2e/orchestration.mjs",
    "test:phase0": "tsc -p tests/phase0/tsconfig.json && node tests/phase0/rewrite-aliases.mjs && node tests/phase0/out/tests/phase0/test.js",
    "test:phase2": "tsc -p tests/phase2/tsconfig.json && node tests/phase2/out/tests/phase2/test.js",
    "test:phase3": "tsc -p tests/phase3/tsconfig.json && node tests/phase3/run.cjs",
    "test:teamview": "tsc -p tests/team-view/tsconfig.json && node tests/team-view/out/tests/team-view/test.js",
    "test:team": "tsc -p tests/team/tsconfig.json && node tests/team/rewrite-aliases.mjs && node tests/team/out/tests/team/test.js",
    "test:n8n": "tsc -p tests/n8n/tsconfig.json && node tests/n8n/run.cjs",
    "test": "npm run test:workflow && npm run test:hardening && npm run test:phase0 && npm run test:phase1 && npm run test:phase2 && npm run test:phase3 && npm run test:teamview && npm run test:team"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@types/three": "^0.184.1",
    "ai": "^7.0.99",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.21.0",
    "mongodb": "^7.4.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "openai": "^7.15.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
