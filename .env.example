# AgentFlow — every variable the code reads. Copy to .env.local and fill in
# real values. Never commit .env.local, and never put a real secret here.

# --- required ---
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>
MONGODB_DB=agentflow
JWT_SECRET=<a-long-random-string>
JWT_ISSUER=agentflow
SESSION_COOKIE_NAME=agentflow_session

# --- inference: configure at least one provider ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=AgentFlow
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3
HF_TOKEN=
HF_MODEL=moonshotai/Kimi-K3
KIMI_API_KEY=
MOONSHOT_API_KEY=

# --- mock (agent generation only) ---
MOCK_LLM=true
NEXT_PUBLIC_MOCK_LLM=true

# --- email (verification + password reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_NO_REPLY=
NO_REPLY_EMAIL=
MAILTRAP_HOST=
MAILTRAP_PORT=
MAILTRAP_USER=
MAILTRAP_PASS=

# --- crypto ---
ENCRYPTION_KEY=<a-different-long-random-string>

# --- billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- app URL (required for Stripe checkout return URLs) ---
DOMAIN=https://your-deployed-app.example.com

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SCOPES=openid email profile

# --- contact form recipient ---
CONTACT_TO_EMAIL=
ADMIN_EMAIL=

# --- dev-only endpoint guard ---
DEV_INIT_COLLECTIONS_SECRET=

# --- platform-set (Vercel supplies these; do not set by hand) ---
# VERCEL, VERCEL_ENV, VERCEL_REGION, NODE_ENV
